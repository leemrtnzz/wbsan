---
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import FallbackImage from '../assets/my.webp';
import { SITE_TITLE } from '../consts';

interface Props {
  title: string;
  description?: string;
  image?: ImageMetadata | string; // boleh metadata atau string URL absolute/relative
  author?: string;
  ogType?: 'website' | 'article';
  ogImageAlt?: string;
  pubDate?: Date | string;
  updatedDate?: Date | string;
  tags?: string[];
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const {
  title,
  description = '',
  image = FallbackImage,
  author,
  ogType = 'website',
  ogImageAlt = title,
  pubDate,
  updatedDate,
  tags = [],
} = Astro.props as Props;

// Buat URL absolut untuk gambar (handle ImageMetadata atau string)
function toAbsUrl(src: string) {
  return new URL(src, Astro.site).href;
}
const imgSrc =
  typeof image === 'string' ? toAbsUrl(image) : toAbsUrl(image.src);
const imgW = typeof image === 'string' ? undefined : image.width?.toString();
const imgH = typeof image === 'string' ? undefined : image.height?.toString();

// URL absolut halaman
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
---
<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/png" href="/favicon.png" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
  rel="alternate"
  type="application/rss+xml"
  title={SITE_TITLE}
  href={new URL('rss.xml', Astro.site)}
/>
<meta name="generator" content={Astro.generator} />

<!-- Font preloads -->
<link rel="preload" href="/fonts/atkinson-regular.woff" as="font" type="font/woff" crossorigin />
<link rel="preload" href="/fonts/atkinson-bold.woff" as="font" type="font/woff" crossorigin />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
{description && <meta name="description" content={description} />}
{author && <meta name="author" content={author} />}
{imgSrc && <meta name="image" content={imgSrc} />}

<!-- Open Graph -->
<meta property="og:type" content={ogType} />
<meta property="og:url" content={pageUrl} />
<meta property="og:title" content={title} />
{description && <meta property="og:description" content={description} />}
{imgSrc && <meta property="og:image" content={imgSrc} />}
{ogImageAlt && <meta property="og:image:alt" content={ogImageAlt} />}
{imgW && <meta property="og:image:width" content={imgW} />}
{imgH && <meta property="og:image:height" content={imgH} />}

{ogType === 'article' && pubDate && (
  <meta property="article:published_time" content={new Date(pubDate).toISOString()} />
)}
{ogType === 'article' && updatedDate && (
  <meta property="article:modified_time" content={new Date(updatedDate).toISOString()} />
)}
{ogType === 'article' && author && (
  <meta property="article:author" content={author} />
)}
{ogType === 'article' && tags.length > 0 && tags.map((t) => (
  <meta property="article:tag" content={t} />
))}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={pageUrl} />
<meta name="twitter:title" content={title} />
{description && <meta name="twitter:description" content={description} />}
{author && <meta name="twitter:creator" content={author} />}
{imgSrc && <meta name="twitter:image" content={imgSrc} />}
